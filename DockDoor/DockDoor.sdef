<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="DockDoor Terminology">

    <suite name="Standard Suite" code="????" description="Common commands for all applications.">
        <command name="quit" code="aaboroot" description="Quit the application.">
            <cocoa class="NSQuitCommand"/>
        </command>
    </suite>

    <suite name="DockDoor Suite" code="DKDR" description="Commands for controlling DockDoor.">

        <!-- Preview Commands -->

        <command name="show preview" code="DKDRshpr" description="Show the preview window for an application.">
            <cocoa class="ShowPreviewCommand"/>
            <direct-parameter type="text" optional="yes" description="The application name, bundle ID, or process ID."/>
            <parameter name="by" code="bytp" type="text" optional="yes" description="How to identify the app: 'name', 'bundle', or 'pid'. Defaults to 'name'.">
                <cocoa key="identifierType"/>
            </parameter>
            <parameter name="at" code="atps" type="text" optional="yes" description="Position as 'x,y' coordinates.">
                <cocoa key="position"/>
            </parameter>
            <parameter name="dock frame" code="dkfr" type="text" optional="yes" description="Dock item frame as 'x,y,width,height' for positioning relative to a dock icon.">
                <cocoa key="dockFrame"/>
            </parameter>
            <parameter name="dock position" code="dkpo" type="text" optional="yes" description="Dock position: 'bottom', 'left', or 'right'. Defaults to actual dock position.">
                <cocoa key="dockPosition"/>
            </parameter>
            <parameter name="with delay" code="wdly" type="boolean" optional="yes" description="Use the hover delay before showing. Defaults to false.">
                <cocoa key="withDelay"/>
            </parameter>
            <result type="text" description="Success or error message."/>
        </command>

        <command name="hide preview" code="DKDRhdpr" description="Hide the current preview window.">
            <cocoa class="HidePreviewCommand"/>
            <result type="text" description="Success or error message."/>
        </command>

        <command name="show switcher" code="DKDRshsw" description="Open the Persistent Window Switcher using Window Switcher Defaults. Repeated calls leave it open. Requires Window Switcher to be enabled.">
            <cocoa class="ShowSwitcherCommand"/>
            <result type="text" description="Success or error message."/>
        </command>

        <!-- Query Commands -->

        <command name="list spaces" code="DKDRlssp" description="List desktop and fullscreen Spaces using DockDoor's global Space numbering.">
            <cocoa class="ListSpacesCommand"/>
            <result type="text" description="JSON array ordered by number, with number, spaceId (string), type (desktop or fullscreen), displayIdentifier, displayName, isCurrent, and canReceiveWindows."/>
        </command>

        <command name="list windows" code="DKDRlswn" description="List all windows or windows for a specific application.">
            <cocoa class="ListWindowsCommand"/>
            <direct-parameter type="text" optional="yes" description="Optional application name, bundle ID, or PID to filter by."/>
            <parameter name="by" code="bytp" type="text" optional="yes" description="How to identify the app: 'name', 'bundle', or 'pid'. Defaults to 'name'.">
                <cocoa key="identifierType"/>
            </parameter>
            <result type="text" description="JSON array of window objects with id, name, app, bundleId, pid, index, appIndex, frame, spaceId, isMinimized, isHidden, createdAt, lastUsedAt."/>
        </command>

        <command name="list apps" code="DKDRlsap" description="List all running applications with windows.">
            <cocoa class="ListAppsCommand"/>
            <result type="text" description="JSON array of app objects with name, bundleId, pid, windowCount."/>
        </command>

        <command name="get active window" code="DKDRgtaw" description="Get the frontmost window ID.">
            <cocoa class="GetActiveWindowCommand"/>
            <result type="text" description="JSON object with windowId, windowName, appName, bundleId, pid, or error if no active window."/>
        </command>

        <command name="switch to space" code="DKDRswsp" description="Switch to a Desktop or fullscreen Space by global number, or by its current Space ID from list spaces. Returns ok after confirmation. An already-current destination is a successful no-op.">
            <cocoa class="SwitchToSpaceCommand"/>
            <direct-parameter type="integer" optional="yes" description="Positive global Space number. Supply either this number or by id, not both."/>
            <parameter name="by id" code="ssid" type="text" optional="yes" description="Space ID string from list spaces. IDs are valid only while that Space exists.">
                <cocoa key="spaceID"/>
            </parameter>
            <result type="text" description="ok after confirmed switching, or error: followed by an explanation."/>
        </command>

        <!-- Window Action Commands -->

        <command name="move window" code="DKDRmvwn" description="Move a window to a numbered Desktop and wait for confirmation. Returns ok or error: followed by an explanation.">
            <cocoa class="MoveWindowCommand"/>
            <direct-parameter description="Window ID or ordered nonempty list of window IDs; use 'active' for the frontmost window.">
                <type type="text"/>
                <type type="text" list="yes"/>
            </direct-parameter>

            <parameter name="to space" code="spnm" type="integer" description="Positive global Space number from list spaces. Only desktop Spaces can receive windows.">
                <cocoa key="spaceNumber"/>
            </parameter>
            <parameter name="switching" code="swsp" type="boolean" optional="yes" description="Switch to the destination after confirmation by focusing the first successfully moved member. Defaults to false, independently of DockDoor settings.">
                <cocoa key="switching"/>
            </parameter>
            <result type="text" description="ok after confirmed movement, or error: followed by a validation, move, cancellation, or timeout explanation."/>
        </command>

        <command name="focus window" code="DKDRfcwn" description="Focus and bring a window to front.">
            <cocoa class="WindowActionCommand"/>
            <direct-parameter type="text" description="Window ID or 'active' for the frontmost window."/>
            <result type="text" description="Success or error message."/>
        </command>

        <command name="minimize window" code="DKDRmnwn" description="Minimize or unminimize a window.">
            <cocoa class="WindowActionCommand"/>
            <direct-parameter description="Window ID or ordered nonempty list of window IDs; use 'active' for the frontmost window.">
                <type type="text"/>
                <type type="text" list="yes"/>
            </direct-parameter>

            <result type="text" description="Success or error message."/>
        </command>

        <command name="close window" code="DKDRclwn" description="Close a window.">
            <cocoa class="WindowActionCommand"/>
            <direct-parameter description="Window ID or ordered nonempty list of window IDs; use 'active' for the frontmost window.">
                <type type="text"/>
                <type type="text" list="yes"/>
            </direct-parameter>

            <result type="text" description="Success or error message."/>
        </command>

        <command name="quit app" code="DKDRqapp" description="Request normal Quit for the apps owning these windows, once per app. Held modifiers do not change this action. A successful request does not confirm that the app has exited.">
            <cocoa class="WindowActionCommand"/>
            <direct-parameter description="Window ID or ordered nonempty list of window IDs; use 'active' for the frontmost window.">
                <type type="text"/>
                <type type="text" list="yes"/>
            </direct-parameter>
            <result type="text" description="ok if requests were accepted, or error: followed by failed window IDs. Successful requests are retained."/>
        </command>

        <command name="force quit app" code="DKDRfqap" description="Request Force Quit for the apps owning these windows, once per app. May discard unsaved changes. A successful request does not confirm that the app has exited.">
            <cocoa class="WindowActionCommand"/>
            <direct-parameter description="Window ID or ordered nonempty list of window IDs; use 'active' for the frontmost window.">
                <type type="text"/>
                <type type="text" list="yes"/>
            </direct-parameter>
            <result type="text" description="ok if requests were accepted, or error: followed by failed window IDs. Successful requests are retained."/>
        </command>

        <command name="maximize window" code="DKDRmxwn" description="Maximize windows to fill their screens. Respects the move/resize foreground preference and reports action failures.">
            <cocoa class="WindowActionCommand"/>
            <direct-parameter description="Window ID or ordered nonempty list of window IDs; use 'active' for the frontmost window.">
                <type type="text"/>
                <type type="text" list="yes"/>
            </direct-parameter>

            <result type="text" description="Success or error message."/>
        </command>

        <command name="hide window" code="DKDRhdwn" description="Hide or unhide the application of a window.">
            <cocoa class="WindowActionCommand"/>
            <direct-parameter description="Window ID or ordered nonempty list of window IDs; use 'active' for the frontmost window.">
                <type type="text"/>
                <type type="text" list="yes"/>
            </direct-parameter>

            <result type="text" description="Success or error message."/>
        </command>

        <command name="toggle fullscreen" code="DKDRtgfs" description="Toggle fullscreen for one window. With a list, exit fullscreen members only; never enter fullscreen as a group.">
            <cocoa class="WindowActionCommand"/>
            <direct-parameter description="Window ID or ordered nonempty list of window IDs; use 'active' for the frontmost window.">
                <type type="text"/>
                <type type="text" list="yes"/>
            </direct-parameter>

            <result type="text" description="Success or error message."/>
        </command>

        <command name="center window" code="DKDRctwn" description="Center windows on their screens. Respects the move/resize foreground preference and reports action failures.">
            <cocoa class="WindowActionCommand"/>
            <direct-parameter description="Window ID or ordered nonempty list of window IDs; use 'active' for the frontmost window.">
                <type type="text"/>
                <type type="text" list="yes"/>
            </direct-parameter>

            <result type="text" description="Success or error message."/>
        </command>

        <!-- Window Positioning Commands -->

        <command name="position window" code="DKDRpswn" description="Position windows independently on their displays, respecting the move/resize foreground preference. Ordered lists use direction-aware Auto Tile on the current Desktop only when the Fill actions Auto Tile setting is enabled. Reports action failures.">
            <cocoa class="PositionWindowCommand"/>
            <direct-parameter description="Window ID or ordered nonempty list of window IDs; use 'active' for the frontmost window.">
                <type type="text"/>
                <type type="text" list="yes"/>
            </direct-parameter>

            <parameter name="to" code="topr" type="text" description="Position: 'left', 'right', 'top', 'bottom', 'top-left', 'top-right', 'bottom-left', 'bottom-right'.">
                <cocoa key="position"/>
            </parameter>
            <result type="text" description="Success or error message."/>
        </command>

        <!-- Window Tiling and Selection Commands -->
        <command name="auto tile window" code="DKDRatwn" description="Fill the current Desktop with one window using the shared tiling operation. A 1x1 tiling limit moves without resizing.">
            <cocoa class="TileWindowsCommand"/>
            <direct-parameter type="text" description="Window ID or 'active'."/>
            <parameter name="bringing to front" code="frnt" type="boolean" optional="yes" description="Raise the tiled window. Defaults to the configured Bring moved/resized windows to front preference.">
                <cocoa key="bringingToFront"/>
            </parameter>
            <result type="text" description="'ok' after completion, or an error. Successful partial changes are not rolled back."/>
        </command>
        <command name="tile windows" code="DKDRtlws" description="Tile an ordered group on the current Desktop. Extra windows stack in the same cells, or remain untouched when Tile only what fits is enabled. A 1x1 limit moves without resizing.">
            <cocoa class="TileWindowsCommand"/>
            <direct-parameter optional="yes" description="List of window IDs in leading order. If omitted, use checked windows, or the active window when none are checked.">
                <type type="text" list="yes"/>
            </direct-parameter>
            <parameter name="to" code="topr" type="text" optional="yes" description="Direction: 'auto', 'left', 'right', 'top', 'bottom', 'top-left', 'top-right', 'bottom-left', 'bottom-right'. Defaults to 'auto'.">
                <cocoa key="position"/>
            </parameter>
            <parameter name="bringing to front" code="frnt" type="boolean" optional="yes" description="Raise all tiled windows with the first in front. Defaults to the configured foreground preference.">
                <cocoa key="bringingToFront"/>
            </parameter>
            <result type="text" description="'ok' after completion, or an error listing failed window IDs. Successful partial changes are retained."/>
        </command>
        <command name="toggle window selection" code="DKDRtwsl" description="Toggle a window's checked membership in an open preview session. Requires multi-window selection enabled.">
            <cocoa class="ToggleWindowSelectionCommand"/>
            <direct-parameter type="text" description="Window ID or 'active'."/>
            <result type="text" description="Success or error message."/>
        </command>
        <command name="reserve screen edge" code="DKDRrsve" description="Reserve space at a screen edge, such as for a custom dock, so DockDoor's window snapping leaves it free. Use the edge 'none' or a thickness of 0 to clear it.">
            <cocoa class="ReserveScreenEdgeCommand"/>
            <direct-parameter type="text" description="Edge: 'bottom', 'left', 'right', 'top', or 'none'."/>
            <parameter name="thickness" code="thck" type="real" optional="yes" description="Height of a bottom or top dock, or width of a left or right dock, in points. A top reservation is measured from below the menu bar.">
                <cocoa key="thickness"/>
            </parameter>
            <parameter name="for" code="srce" type="text" optional="yes" description="Who is reserving the space, such as your app's bundle ID. A reservation made for a bundle ID ends when that app quits. Defaults to 'applescript'.">
                <cocoa key="source"/>
            </parameter>
            <parameter name="on display" code="dspl" type="text" optional="yes" description="Display UUID or display ID, or 'main'. Defaults to every display.">
                <cocoa key="display"/>
            </parameter>
            <result type="text" description="Success or error message."/>
        </command>

        <!-- Window Data Commands (with images) -->
        <command name="get window" code="DKDRgtwn" description="Get window info including cached preview image.">
            <cocoa class="GetWindowCommand"/>
            <direct-parameter type="text" description="Window ID or 'active' for the frontmost window."/>
            <result type="text" description="JSON object with windowId, windowName, appName, bundleId, pid, frame, image (base64 PNG), imageWidth, imageHeight, imageCapturedAt."/>
        </command>

        <command name="get windows" code="DKDRgtws" description="Get all windows including cached preview images.">
            <cocoa class="GetWindowsCommand"/>
            <direct-parameter type="text" optional="yes" description="Application name, bundle ID, or PID. If omitted, returns all windows."/>
            <parameter name="by" code="bytp" type="text" optional="yes" description="How to identify the app: 'name', 'bundle', or 'pid'. Defaults to 'name'.">
                <cocoa key="identifierType"/>
            </parameter>
            <result type="text" description="JSON array of window objects with windowId, windowName, appName, bundleId, pid, frame, image (base64 PNG), imageWidth, imageHeight, imageCapturedAt."/>
        </command>

        <!-- Help Command -->

        <command name="get help" code="DKDRhlpc" description="Get help and list all available commands.">
            <cocoa class="GetHelpCommand"/>
            <result type="text" description="Help text listing all available commands and their usage."/>
        </command>

    </suite>

</dictionary>
